# ─── Telegram (required) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=your_telegram_chat_id_here

# ─── Channels ────────────────────────────────────────────────────────────────
SOURCE_CHANNEL_ID=UC8semOV-MqT3enT4M0mS1ow
TARGET_CHANNEL_ID=UCCKQxDfs0eIVsLmnc4JVtpQ

# OAuth client downloaded from Google Cloud Console (Desktop app type).
YOUTUBE_CLIENT_SECRET_FILE=config/client_secret.json
# Auto-generated on first authorisation — never commit.
YOUTUBE_TOKEN_FILE=config/token.json

# ─── Scheduler (Asia/Riyadh, 24h) ────────────────────────────────────────────
TIMEZONE=Asia/Riyadh
CHECK_INTERVAL_MINUTES=120
# Daily top-up with older source videos when fewer than this went up (0 = off).
DAILY_UPLOAD_TARGET=6
BACKFILL_TIME=09:00

# ─── Download ────────────────────────────────────────────────────────────────
DOWNLOAD_DIR=downloads
MAX_VIDEO_AGE_DAYS=7
VIDEO_QUALITY=best[height<=1080]
SCAN_LIMIT=20
BACKFILL_SCAN_LIMIT=300
MAX_UPLOADS_PER_RUN=5
KEEP_AFTER_UPLOAD=false
# Leave blank to use ffmpeg from PATH (apt installs it there).
FFMPEG_LOCATION=
# Netscape cookies.txt from a throwaway Google account. Needed on cloud IPs
# ("Sign in to confirm you're not a bot"). Never commit it. Blank = none.
YTDLP_COOKIES_FILE=

# ─── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_PRIVACY=public
UPLOAD_CATEGORY_ID=22
ADD_SOURCE_CREDIT=true
UPLOAD_MAX_RETRIES=5

# ─── Optional: Facebook Page (second upload target) ─────────────────────────
# Page ID: Page → About → Page transparency. Token: long-lived Page access token
# with pages_manage_posts + pages_read_engagement (+ publish_video). Never commit it.
FB_ENABLED=false
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v27.0
FB_RETRY_PER_RUN=3
# Reels: auto = Reel if the clip is 3–90 s (short landscape clips padded to 9:16), else normal video
FB_FORMAT=auto
FB_REELS_MAX_SECONDS=90
FB_REELS_PAD=true
# Warm-up for a dormant Page: posts/day for week 1, week 2, ... then FB_DAILY_LIMIT (0 = no cap).
# Over-cap videos queue in /data/facebook_state.json. Posts spread over ~16h (16h / cap apart).
FB_WARMUP_SCHEDULE=1,3
FB_WARMUP_START=
FB_DAILY_LIMIT=8
FB_MIN_GAP_MINUTES=90

# ─── Optional: Instagram (Shorts only, as Reels) ────────────────────────────
# Source = the channel's Shorts tab. Needs a Professional (Business/Creator) IG
# account linked to the Page and a Page token that also has instagram_basic +
# instagram_content_publish. IG_ACCESS_TOKEN empty = reuse FB_PAGE_TOKEN.
# Find IG_USER_ID: python -m src.ig_uploader check
IG_ENABLED=false
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_MAX_SECONDS=180
# Max posts per local day (0 = no cap) and minimum gap for automatic posts.
IG_DAILY_LIMIT=3
IG_MIN_GAP_MINUTES=180
# true: when there is no new Short, post an older one (newest first) up to the cap.
IG_TOPUP=true

# ─── Optional: X / Twitter (Shorts only, title-only posts) ──────────────────
# Pay-per-use API (~$0.015/post; a link makes it $0.20, so no links are posted).
# Consumer Key/Secret from the app; Access Token/Secret for the POSTING account,
# made with the OAuth 1.0a PIN flow. Test: python -m src.x_uploader check --upload
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MAX_SECONDS=180
X_DAILY_LIMIT=3
X_MIN_GAP_MINUTES=180
X_TOPUP=true

# ─── Optional: TikTok (Shorts only) ──────────────────────────────────────────
# Content Posting API (Direct Post). Client key/secret from developers.tiktok.com; the posting
# account's token is made once with ~/relay-setup/tiktok-auth.py and stored in DATA_DIR/tiktok_token.json.
# Unaudited app → SELF_ONLY (private) only. Test: python -m src.tiktok_uploader check
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
TIKTOK_MAX_SECONDS=180
TIKTOK_DAILY_LIMIT=3
TIKTOK_MIN_GAP_MINUTES=180
TIKTOK_TOPUP=true

# ─── Captions ────────────────────────────────────────────────────────────────
# Credit "<label>: <channel>" (+ link on YouTube/Facebook); hashtags: first 3 YT/FB, 5 IG/TikTok, 2 X.
CAPTION_CREDIT_LABEL=المصدر
CAPTION_HASHTAGS=#فتاوى #فقه #إسلام #سؤال_وجواب #دروس_علمية

# ─── Health ──────────────────────────────────────────────────────────────────
# Daily Telegram reminder for credentials (cookies, Facebook token, TikTok login) expiring soon.
REMIND_DAYS=14
EXPIRY_CHECK_TIME=10:00
# Watchdog: alert when no run finished for N hours, or one run lasts over N minutes.
WATCHDOG_MINUTES=30
SILENT_ALERT_HOURS=6
STUCK_ALERT_MINUTES=90
# Optional external dead-man's switch (alerts even if the whole bot is down), e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Optional: Gemini (free tier) ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_ENABLED=false
